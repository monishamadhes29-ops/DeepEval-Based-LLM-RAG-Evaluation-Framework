# Backend Server Configuration
# Read by backend/src/config/env.ts. Model config and API keys (EVAL_MODEL, GROQ_API_KEY,
# OPENAI_API_KEY, thresholds, IDK_HANDLING, logging, custom G-Eval) live in
# llm-eval-providers/.env instead - the Node backend never calls the LLMs directly, it just
# proxies to the Python deepeval service over HTTP, so no API keys are needed here.

# Backend server port (must match frontend's BACKEND_URL / vite proxy target, both set to 3002)
PORT=3002
