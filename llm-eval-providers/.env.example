# DeepEval Server Configuration
PORT=3002
# LLM Evaluation Model
# Options: gpt-4, gpt-4o,gpt-4o-mini, gpt-3.5-turbo, llama-3.3-70b-versatile, qwen/qwen3.6-27b etc.
# Default: llama-3.3-70b-versatile
EVAL_MODEL=llama-3.3-70b-versatile
#EVAL_MODEL=gpt-4o-mini
# API Keys (choose based on EVAL_MODEL)
# For Groq models (llama-*, mixtral-*, etc.)
GROQ_API_KEY=your_groq_api_key_here
# For OpenAI models (gpt-*)
#OPENAI_API_KEY=your_openai_api_key_here
# IDK Handling Configuration for Faithfulness Metric
# How to treat "idk"  in faithfulness evaluation:
# - "yes": Treat ambiguous claims as supported (lenient scoring, higher scores)
# - "no": Treat ambiguous claims as unsupported (strict scoring, lower scores)
IDK_HANDLING=no

# Logging Configuration
# LOG_DIR: directory where hourly log files are written (default: logs)
# LOG_LEVEL: INFO (default) or DEBUG - DEBUG also logs full per-request field dumps
# LOG_RETENTION_HOURS: how many hourly log files to keep before rotating out (default: 168 = 7 days)
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_HOURS=24

# ==============================================================================
# Scoring Thresholds
# All values below are commented out at their current hardcoded defaults - the
# server behaves identically whether these lines are present or not. Uncomment
# and change a value to tune that metric's behavior without touching code.
# ==============================================================================

# --- DeepEval metric "threshold" (pass/fail cutoff DeepEval itself uses internally,
#     e.g. for CI-style assertions). Does not affect the score or the verdict labels below. ---
FAITHFULNESS_THRESHOLD=0.5
ANSWER_RELEVANCY_THRESHOLD=0.5
CONTEXTUAL_PRECISION_THRESHOLD=0.5
CONTEXTUAL_RECALL_THRESHOLD=0.5
PII_LEAKAGE_THRESHOLD=0.5
BIAS_THRESHOLD=0.5
HALLUCINATION_THRESHOLD=0.5
TOXICITY_THRESHOLD=0.5
CONVERSATION_COMPLETENESS_THRESHOLD=0.5
# Note: RAGAS is a composite of Faithfulness + Contextual Precision + Contextual
# Recall, so it reuses the three THRESHOLD vars above rather than having its own.

# --- Verdict-band cutoffs (control the human-readable verdict label returned per
#     metric, e.g. FAITHFUL/PARTIAL/NOT_FAITHFUL). Each metric has a HIGH and LOW
#     cutoff; score >= HIGH -> best label, score >= LOW -> partial label, else worst label.
#     Bias/Hallucination/PII use "lower score = better" so their HIGH/LOW comparisons
#     are inverted accordingly in code - the two values below are still just cutoffs. ---
FAITHFULNESS_VERDICT_HIGH=0.75
FAITHFULNESS_VERDICT_LOW=0.3
CONTEXTUAL_RECALL_VERDICT_HIGH=0.75
CONTEXTUAL_RECALL_VERDICT_LOW=0.5
CONTEXTUAL_PRECISION_VERDICT_HIGH=0.75
CONTEXTUAL_PRECISION_VERDICT_LOW=0.5
RAGAS_VERDICT_HIGH=0.7
RAGAS_VERDICT_LOW=0.5
ANSWER_RELEVANCY_VERDICT_HIGH=0.75
ANSWER_RELEVANCY_VERDICT_LOW=0.3
PII_LEAKAGE_VERDICT_HIGH=0.75
PII_LEAKAGE_VERDICT_LOW=0.5
BIAS_VERDICT_LOW=0.25
BIAS_VERDICT_HIGH=0.5
HALLUCINATION_VERDICT_LOW=0.25
HALLUCINATION_VERDICT_HIGH=0.5
TOXICITY_VERDICT_LOW=0.25
TOXICITY_VERDICT_HIGH=0.5
CONVERSATION_COMPLETENESS_VERDICT_HIGH=0.75
CONVERSATION_COMPLETENESS_VERDICT_LOW=0.3

# ==============================================================================
# Token Cost Estimation
# Rough $/1K-token rates used to estimate cost from the token counts Groq returns.
# Only applies to the Groq path (GroqModel) - the OpenAI path (deepeval's built-in
# GPTModel) doesn't expose per-call usage the same way, so usage/cost is omitted
# for it rather than guessed. Defaults below approximate Groq llama-3.3-70b pricing
# at time of writing; real pricing changes over time and by model, so treat the
# resulting numbers as directional, not billing-accurate. Uncomment to override.
# ==============================================================================
#PRICE_PER_1K_PROMPT_TOKENS=0.00059
#PRICE_PER_1K_COMPLETION_TOKENS=0.00079

# ==============================================================================
# Custom Metrics (G-Eval) - https://deepeval.com/docs/metrics-llm-evals
# Each custom metric preset (e.g. "correctness") is configured via CUSTOM_GEVAL_<NAME>_*
# vars below, same pattern as the built-in metrics' *_THRESHOLD/_VERDICT_HIGH/_LOW above.
# All values are commented out at their hardcoded defaults - uncomment to override.
# Served by the dedicated /custom-metrics* endpoints, separate from /eval.
# ==============================================================================
#CUSTOM_GEVAL_CORRECTNESS_CRITERIA=Determine whether the actual output is factually correct, complete, and consistent with the expected output (and context, if provided).
# Comma-separated subset of: input, actual_output, expected_output, context, retrieval_context
CUSTOM_GEVAL_CORRECTNESS_EVALUATION_PARAMS=input,actual_output,expected_output
CUSTOM_GEVAL_CORRECTNESS_THRESHOLD=0.6
CUSTOM_GEVAL_CORRECTNESS_VERDICT_HIGH=0.75
CUSTOM_GEVAL_CORRECTNESS_VERDICT_LOW=0.3
